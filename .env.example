# ── Django ───────────────────────────────────────────────────────
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=ecombackend.miguelmissetcho.com
CORS_ALLOWED_ORIGINS=https://dinomarket.vercel.app
# Chemin de l'admin (évite /admin/, trop connu) et lien « Voir le site » de l'admin
ADMIN_URL=gestion-changez-moi/
FRONTEND_URL=https://dinomarket.vercel.app

# ── PostgreSQL (conteneur `db` en Docker ; DB_HOST est forcé à `db` par le compose) ──
DB_NAME=dinomarket
DB_USER=dinomarket_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── MinIO (stockage des fichiers uploadés) ─────────────────────
# URL utilisée par Django pour parler à l'API S3 de MinIO.
# Même réseau Docker que MinIO → http://<nom-du-conteneur>:9000 ; sinon l'URL publique de l'API.
MINIO_ENDPOINT_URL=https://minio.miguelmissetcho.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ecom-media
MINIO_REGION=us-east-1
# Domaine public + bucket utilisé dans les URLs renvoyées au frontend (sans https://)
MINIO_PUBLIC_DOMAIN=minio.miguelmissetcho.com/ecom-media

# ── Email ────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Déploiement Docker / Traefik (VPS uniquement) ────────────────
BACKEND_DOMAIN=ecombackend.miguelmissetcho.com
# Réseau Docker externe sur lequel écoute Traefik
TRAEFIK_NETWORK=traefik
# Nom de l'entrypoint HTTPS et du certresolver dans ta config Traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
